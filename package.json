{
  "name": "bpes-student-vue-split",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "install:all": "npm ci --prefix backend && npm ci --prefix frontend",
    "setup": "npm --prefix backend run setup",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "build": "npm --prefix frontend run build",
    "preview:frontend": "npm --prefix frontend run preview",
    "test": "npm --prefix backend test"
  }
}
